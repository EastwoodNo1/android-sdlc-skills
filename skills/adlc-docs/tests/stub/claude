#!/usr/bin/env bash
[ -n "${ADLC_STUB_LOG:-}" ] && printf '%s\n' "$*" >>"$ADLC_STUB_LOG"
[ "${ADLC_STUB_FAIL:-}" = "1" ] && exit 1
for arg in "$@"; do
  case "$arg" in
    *"NOTE: "*)
      path=$(printf '%s\n' "$arg" | sed -n 's/^NOTE: //p' | head -n 1)
      if [ -n "$path" ]; then
        printf '# stub note\nContact someone@example.com about /Users/x/project\n' >"$path"
        [ "${ADLC_STUB_BAD_BYTE:-}" = "1" ] && printf 'bad \377 byte\n' >>"$path"
      fi
      ;;
  esac
done
[ "${ADLC_STUB_FAIL_AFTER_WRITE:-}" = "1" ] && exit 1
exit 0
